# ==============================================================================
# WVISMIS Backend - Development Environment (.env.dev)
# Usage: ENV_FILE=.env.dev uvicorn app.main:app --reload
# ==============================================================================

# Application Configuration
APP_NAME="WVISMIS - WinVinaya MIS (Development)"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=127.0.0.1
PORT=8000
WORKERS=1

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wvismis

# Security & JWT Configuration
SECRET_KEY=wvismis_dev_secret_8a4f2c9e1b7d3f6a0c5e8b2d4f9a1c7e3b6d0f8a2c4e9b1d
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Default Admin & Tenant Bootstrap
FIRST_SUPERUSER=admin@winvinaya.com
FIRST_SUPERUSER_PASSWORD=DevAdminPassword123!
DEFAULT_ORGANIZATION_NAME="WinVinaya Infosystems (Dev)"
DEFAULT_ORGANIZATION_SLUG="winvinaya"

# CORS Origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_HOUR=5000

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FILE=logs/app_dev.log
LOG_ROTATION="100 MB"
LOG_RETENTION="14 days"
LOG_FORMAT=text

# WebSocket & Streaming Configuration
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS_PER_ORG=200

# Harness Agentic AI Engine Configuration
AI_ENABLED=True
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
AI_MAX_TOOL_CALLS_PER_RUN=15
AI_TASK_TIMEOUT_SECONDS=120
AI_APPROVAL_RECORD_THRESHOLD=5
