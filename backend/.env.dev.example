# ==============================================================================
# WVISMIS Backend - Development Environment (.env.dev)
# Usage: ENV_FILE=.env.dev uvicorn app.main:app --reload
# ==============================================================================

# Application Configuration
APP_NAME="WVISMIS - WinVinaya MIS (Development)"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=127.0.0.1
PORT=8000
WORKERS=1

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wvismis

# Security & JWT Configuration
SECRET_KEY=wvismis_dev_secret_8a4f2c9e1b7d3f6a0c5e8b2d4f9a1c7e3b6d0f8a2c4e9b1d
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Default Admin & Tenant Bootstrap
FIRST_SUPERUSER=dharanidaran.a@winvinaya.com
FIRST_SUPERUSER_PASSWORD=Testpass@123
DEFAULT_ORGANIZATION_NAME="WinVinaya Infosystems"
DEFAULT_ORGANIZATION_SLUG="winvinaya"

# CORS Origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_HOUR=5000

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FILE=logs/app_dev.log
LOG_ROTATION="100 MB"
LOG_RETENTION="14 days"
LOG_FORMAT=text

# WebSocket & Streaming Configuration
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS_PER_ORG=200

# Harness Agentic AI Engine Configuration
AI_ENABLED=True
AI_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
AI_MODEL_ANTHROPIC=claude-sonnet-4-6
AI_MODEL_GEMINI=gemini-3.6-flash,gemini-3.5-flash-lite
AI_MAX_TOOL_CALLS_PER_RUN=15
AI_TASK_TIMEOUT_SECONDS=120
AI_APPROVAL_RECORD_THRESHOLD=5

# Email Configuration
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=s.mail25.info
SMTP_USER=no-reply@winvinaya.com
SMTP_PASSWORD=Admin##2025@
EMAILS_FROM_EMAIL=no-reply@winvinaya.com
EMAILS_FROM_NAME=winvinaya
EMAIL_NOTIFICATIONS_ENABLED=True
