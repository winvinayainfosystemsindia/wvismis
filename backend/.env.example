# ==============================================================================
# WVISMIS Backend - Environment Configuration Template
# Copy to .env (or .env.dev / .env.prod and set ENV_FILE accordingly)
# ==============================================================================

# Application Configuration
APP_NAME="WVISMIS - WinVinaya MIS"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=wvismis

# Security & JWT Configuration
SECRET_KEY=wvismis_secret_key_change_in_production_min_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Default Admin & Tenant Bootstrap
FIRST_SUPERUSER=dharanidaran.a@winvinaya.com
FIRST_SUPERUSER_PASSWORD=Testpass@123
DEFAULT_ORGANIZATION_NAME="WinVinaya Infosystems"
DEFAULT_ORGANIZATION_SLUG="winvinaya"

# CORS Origins (comma-separated or JSON array)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_ROTATION="500 MB"
LOG_RETENTION="30 days"
LOG_FORMAT=json

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# WebSocket & Streaming Configuration
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS_PER_ORG=500

# Harness Agentic AI Engine Configuration
AI_ENABLED=True
AI_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=gemini

# LLM Provider API Keys (optional - can also be managed via /api/v1/ai/settings)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Default Models per Provider
AI_MODEL_ANTHROPIC=claude-3-7-sonnet-20250219
AI_MODEL_GEMINI=gemini-3.6-flash,gemini-3.5-flash-lite
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_MISTRAL=mistral-small-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# AI Harness Safety & Guardrails
AI_MAX_TOOL_CALLS_PER_RUN=15
AI_TASK_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=3
AI_APPROVAL_RECORD_THRESHOLD=5
AI_LOG_RETENTION_DAYS=90
