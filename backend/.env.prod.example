# ==============================================================================
# WVISMIS Backend - Production Environment (.env.prod)
# Usage: ENV_FILE=.env.prod uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4
# ==============================================================================

# Application Configuration
APP_NAME="WVISMIS - WinVinaya MIS"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=False
ENVIRONMENT=production

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wvismis_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_DB_PASSWORD
POSTGRES_DB=wvismis

# Security & JWT Configuration
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_PRODUCTION_SECRET_KEY_BEFORE_DEPLOYMENT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Default Admin & Tenant Bootstrap
FIRST_SUPERUSER=dharanidaran.a@winvinaya.com
FIRST_SUPERUSER_PASSWORD=Testpass@123
DEFAULT_ORGANIZATION_NAME="WinVinaya Infosystems"
DEFAULT_ORGANIZATION_SLUG="winvinaya"

# CORS Origins
BACKEND_CORS_ORIGINS=https://mis.winvinaya.com,https://www.mis.winvinaya.com

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=2000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app_prod.log
LOG_ROTATION="500 MB"
LOG_RETENTION="60 days"
LOG_FORMAT=json

# WebSocket & Streaming Configuration
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS_PER_ORG=1000

# Harness Agentic AI Engine Configuration
AI_ENABLED=True
AI_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
AI_MODEL_ANTHROPIC=claude-3-7-sonnet-20250219
AI_MODEL_GEMINI=gemini-3.6-flash,gemini-3.5-flash-lite
AI_MAX_TOOL_CALLS_PER_RUN=15
AI_TASK_TIMEOUT_SECONDS=120
AI_APPROVAL_RECORD_THRESHOLD=5

# Email Configuration
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=s.mail25.info
SMTP_USER=no-reply@winvinaya.com
SMTP_PASSWORD=Admin##2025@
EMAILS_FROM_EMAIL=no-reply@winvinaya.com
EMAILS_FROM_NAME=winvinaya
EMAIL_NOTIFICATIONS_ENABLED=True
